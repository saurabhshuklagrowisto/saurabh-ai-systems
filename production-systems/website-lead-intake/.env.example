# Close API key. Settings -> API Keys in Close. Set this in your host's env vars, not in code.
CLOSE_API_KEY=api_xxxxxxxxxxxxxxxxxxxxxxxx

# Any random string. The form must send it as the x-form-secret header.
# Leave empty to disable the check (open endpoint, only do this while testing).
FORM_SHARED_SECRET=

# Close webhook signature key. Close returns it once, when the webhook subscription is
# created. Hex string. Without it /api/reply is unauthenticated, so set it in production.
CLOSE_WEBHOOK_SIGNATURE_KEY=

# Slack incoming webhook for the daily reply digest. Leave empty to skip Slack and read
# the digest from the endpoint's JSON response instead.
SLACK_WEBHOOK_URL=

# Any random string. The daily cron must send it as the x-digest-secret header
# or as ?secret= on the URL. Leave empty to disable the check.
DIGEST_SECRET=
